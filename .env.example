# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → Data API (URL) and API Keys (anon / publishable).
#
# Both values are safe to ship in a client bundle — the anon key is public by
# design and access is governed by the policies in supabase/migrations.
#
# Leave these unset and the app still runs; only "Play on one device" works.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
